{
  "name": "sowa-storefront",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "extract": "formatjs extract",
    "verify": "formatjs verify --missing-keys",
    "compile": "formatjs compile",
    "extract-compile": "formatjs extract 'src/**/*.ts*' --ignore 'src/**/*.d.ts' --out-file 'src/lang/extracted.json' --flatten --id-interpolation-pattern '[sha512:contenthash:base64:6]' && formatjs compile 'src/lang/extracted.json' --out-file 'src/lang/en.json' --ast && rm 'src/lang/extracted.json'",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.1.1",
    "@ory/cli": "^1.1.0",
    "@ory/client": "^1.16.6",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-collapsible": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@sentry/react": "^9.31.0",
    "@sentry/vite-plugin": "^3.5.0",
    "@supabase/auth-ui-react": "^0.4.7",
    "@supabase/supabase-js": "^2.50.0",
    "@tanstack/react-query": "^5.66.0",
    "@tanstack/react-router": "^1.99.0",
    "@tanstack/react-table": "^8.21.3",
    "axios": "^1.10.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.13",
    "immer": "^10.1.1",
    "jotai": "^2.11.3",
    "jotai-devtools": "^0.12.0",
    "jotai-immer": "^0.4.1",
    "jotai-tanstack-query": "^0.9.0",
    "lucide-react": "^0.518.0",
    "next-themes": "^0.4.6",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-hook-form": "^7.58.1",
    "react-intl": "^7.1.6",
    "sonner": "^2.0.5",
    "supabase": ">=1.8.1",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@formatjs/cli": "^6.6.1",
    "@tailwindcss/vite": "^4.1.10",
    "@tanstack/eslint-plugin-query": "^5.78.0",
    "@tanstack/react-query-devtools": "^5.66.0",
    "@tanstack/react-router-devtools": "^1.120.20",
    "@tanstack/router-plugin": "^1.99.3",
    "@types/node": "^22.13.1",
    "@types/react": "^19.1.7",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.5.2",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "formatjs": "^0.1.1",
    "globals": "^15.14.0",
    "postcss": "^8.5.1",
    "tailwindcss": "^4.1.10",
    "tw-animate-css": "^1.3.4",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.18.2",
    "vite": "^6.0.5"
  }
}
