{
  "name": "sowa-storefront",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "ci": "yarn install --frozen-lockfile",
    "dev": "vite",
    "extract": "formatjs extract",
    "verify": "formatjs verify --missing-keys",
    "compile": "formatjs compile",
    "extract-compile": "formatjs extract 'src/**/*.ts*' --ignore 'src/**/*.d.ts' --out-file 'src/lang/extracted.json' --flatten --id-interpolation-pattern '[sha512:contenthash:base64:6]' && formatjs compile 'src/lang/extracted.json' --out-file 'src/lang/en.json' --ast && rm 'src/lang/extracted.json'",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@hookform/resolvers": "^4.0.0",
    "@ory/client": "^1.22.26",
    "@tailwindcss/vite": "^4.2.1",
    "@tanstack/query-core": "^5.66.0",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-router": "^1.166.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.577.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.71.2",
    "react-intl": "^7.1.6",
    "shadcn": "^4.0.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss-animate": "^1.0.7",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@formatjs/cli": "^6.6.1",
    "@tailwindcss/postcss": "^4.2.1",
    "@tanstack/eslint-plugin-query": "^5.66.0",
    "@tanstack/react-query-devtools": "^5.91.3",
    "@tanstack/router-devtools": "^1.166.2",
    "@tanstack/router-plugin": "^1.166.2",
    "@types/node": "^22.13.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react-swc": "^3.5.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "formatjs": "^0.1.1",
    "globals": "^15.14.0",
    "tailwindcss": "^4.2.1",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.18.2",
    "vite": "^6.0.5"
  }
}
